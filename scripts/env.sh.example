# Source before running scripts/parse_tiered.py on a parsing server (copy to env.sh and adjust L).
L=$HOME/delphin/lenka   # where ACE, the grammar image, scripts and venv live on this machine
export ERG_ACE=$L/bin/ace
export ERG_GRAMMAR=$L/grammar/erg-ace0934.dat
export PATH=$L/venv/bin:$PATH
export LC_ALL=C.UTF-8   # avoids PyDelphin failing on a forwarded locale the server lacks
